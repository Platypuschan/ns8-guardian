{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "add-member",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "ca": {
      "type": "string",
      "maxLength": 12000
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
    }
  }
}